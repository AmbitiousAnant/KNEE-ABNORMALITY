anufacturer}|{model}\"\n            except Exception:\n                pass\n        records.append({\"StudyInstanceUID\": study_uid, \"Scanner_ID\": scanner_id})\n        \n    out = pd.DataFrame(records)\n    assert out[\"StudyInstanceUID\"].is_unique, \"Merge will fan out and corrupt train_df\"\n    return out\n\n# 2. Corrected Regex NLP Parsing\ncondition_to_col = {\n    \"ACL\": \"ACL\", \"MCL\": \"MCL\",\n    \"Medial Meniscus\": \"Medial Meniscus\", \"Lateral Meniscus\": \"Lateral Meniscus\",\n    \"Medial OA\": \"Medial OA\", \"Lateral OA\": \"Lateral OA\", \"PF OA\": \"PF OA\",\n    \"Effusion\": \"Effusion\", \"Synovitis\": \"Synovitis\", \"Baker's\": \"Baker's\",\n    \"Contusion\": \"Contusion\", \"Fracture\": \"Fracture\",\n}\n\nkeywords = {\n    \"ACL\": [\"acl\", \"anterior cruciate\"], \"MCL\": [\"mcl\", \"medial collateral\"],\n    \"Medial Meniscus\": [\"medial meniscus\"], \"Lateral Meniscus\": [\"lateral meniscus\"],\n    \"Medial OA\": [\"medial compartment\", \"medial osteoarthritis\"], \"Lateral OA\": [\"lateral compartment\", \"lateral osteoarthritis\"],\n    \"PF OA\": [\"patellofemoral\", \"trochlear\"], \"Effusion\": [\"effusion\", \"fluid\"],\n    \"Synovitis\": [\"synovitis\"], \"Baker's\": [\"baker\", \"popliteal cyst\"],\n    \"Contusion\": [\"contusion\", \"bruise\", \"marrow edema\"], \"Fracture\": [\"fracture\", \"fx\"]\n}\nnegations = [\"no \", \"without \", \"negative for \", \"unremarkable\", \"intact\", \"normal\"]\n\ndef parse_clinical_report(report):\n    labels = {col: 0.1 for col in CFG.target_cols}\n    if not isinstance(report, str):\n        return pd.Series(labels)\n        \n    for sentence in re.split(r'[.\\n]', report.lower()):\n        is_negated = any(neg in sentence for neg in negations)\n        for condition, triggers in keywords.items():\n            if any(t in sentence for t in triggers) and not is_negated:\n                labels[condition_to_col[condition]] = 0.9\n                \n    return pd.Series(labels)\n\n# 3. Data Construction (Order of Operations is Critical)\ntrain_df = pd.read_csv(CFG.train_csv)\ntrain_series_df = pd.read_csv(CFG.train_series_csv)\n\n# A. FLAG GOLD STRICTLY FIRST\ntrain_df[\"is_gold\"] = train_df[CFG.target_cols].notnull().all(axis=1)\n\n# B. GENERATE PSEUDO-LABELS & MERGE\npseudo_labels_df = train_df['Report'].apply(parse_clinical_report)\ntrain_df.update(pseudo_labels_df, overwrite=False) \n\n# C. MERGE SCANNER METADATA\nscanner_df = extract_scanner_metadata(train_series_df, CFG.train_dicom_dir)\ntrain_df = train_df.merge(scanner_df, on=\"StudyInstanceUID\", how=\"left\").fillna({\"Scanner_ID\": \"UNKNOWN\"})\n\ntrain_df.to_csv(\"train_with_robust_labels.csv\", index=False)\nprint(f\"Total Studies: {len(train_df)} | Pure Gold Studies: {train_df['is_gold'].sum()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T09:25:20.69703Z","iopub.execute_input":"2026-09-08T09:25:20.69732Z","iopub.status.idle":"2026-09-08T09:25:47.544512Z","shell.execute_reply.started":"2026-09-08T09:25:20.697299Z","shell.execute_reply":"2026-09-08T09:25:47.543488Z"}},"outputs":[{"name":"stdout","text":"Total Studies: 4407 | Pure Gold Studies: 58\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"def seed_everything(seed=CFG.seed):\n    random.seed(seed)\n    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed(seed)\n    torch.backends.cudnn.deterministic = True\n\nseed_everything()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T09:25:47.546223Z","iopub.execute_input":"2026-09-08T09:25:47.546618Z","iopub.status.idle":"2026-09-08T09:25:47.553707Z","shell.execute_reply.started":"2026-09-08T09:25:47.546592Z","shell.execute_reply":"2026-09-08T09:25:47.552954Z"}},"outputs":[],"execution_count":15},{"cell_type":"code","source":"import os\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nimport numpy as np\nimport timm\nfrom torchvision.transforms import v2\n\n# ==========================================\n# 1. PyTorch Native Tensor Augmentations \n# ==========================================\n# (Keep this definition here, but we will call it in the training loop!)\ntrain_transforms = v2.Compose([\n    v2.RandomHorizontalFlip(p=0.5),\n    v2.RandomAffine(degrees=15, translate=(0.05, 0.05), scale=(0.95, 1.05)),\n])\n\n# ==========================================\n# 2. Lightning-Fast .npy Dataset (Zero Math!)\n# ==========================================\nclass KneeMRIDatasetRAM(Dataset):\n    def __init__(self, df, npy_dir, is_train=True):\n        self.df = df.reset_index(drop=True)\n        \n        targets_df = self.df[CFG.target_cols].fillna(0.0).astype(float)\n        self.targets = targets_df.values.astype(np.float32)\n\n        print(f\"Loading {len(self.df)} arrays into RAM...\")\n        self.images = []\n        missing_files = 0\n        \n        for idx in tqdm(range(len(self.df)), desc=\"Caching to RAM\"):\n            study_uid = str(self.df.loc[idx, \"StudyInstanceUID\"]).strip()\n            \n            # This is where the break is happening\n            npy_path = os.path.join(npy_dir, f\"{study_uid}.npy\")\n            \n            if not os.path.exists(npy_path):\n                missing_files += 1\n                img_np = np.zeros((5, CFG.img_size, CFG.img_size), dtype=np.float32)\n            else:\n                try:\n                    img_np = np.load(npy_path).astype(np.float32) \n                    img_min, img_max = img_np.min(), img_np.max()\n                    if img_max > img_min:\n                        img_np = (img_np - img_min) / (img_max - img_min)\n                    else:\n                        img_np = np.zeros_like(img_np)\n                except Exception:\n                    img_np = np.zeros((5, CFG.img_size, CFG.img_size), dtype=np.float32)\n                    \n            self.images.append(img_np)\n            \n        if missing_files > 0:\n            print(f\"\\n[CRITICAL WARNING] {missing_files} out of {len(self.df)} arrays were missing!\")\n            print(f\"I tried looking for this exact file as an example: {npy_path}\")\n            \n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        img_tensor = torch.from_numpy(self.images[idx])\n        return img_tensor, torch.tensor(self.targets[idx])\n# ==========================================\n# 3. Attention Pooling Mechanism\n# ==========================================\nclass AttentionPooling(nn.Module):\n    def __init__(self, in_features):\n        super().__init__()\n        self.attention = nn.Sequential(\n            nn.Linear(in_features, in_features // 2),\n            nn.Tanh(),\n            nn.Linear(in_features // 2, 1),\n            nn.Softmax(dim=1)\n        )\n\n    def forward(self, x):\n        if x.dim() == 4:\n            b, c, h, w = x.shape\n            x = x.view(b, c, h * w).transpose(1, 2)\n            \n        weights = self.attention(x)\n        pooled = torch.sum(x * weights, dim=1)\n        return pooled\n        \nclass MultiLabelFocalLoss(nn.Module):\n    def __init__(self, gamma=2.0, pos_weight=None):\n        super().__init__()\n        self.gamma = gamma\n        self.pos_weight = pos_weight\n\n    def forward(self, logits, targets):\n        probs = torch.sigmoid(logits)\n        # Calculate pt: the probability of the true class\n        pt = torch.where(targets == 1, probs, 1 - probs)\n        \n        # Standard BCE with your dynamic positive weights\n        bce_loss = nn.functional.binary_cross_entropy_with_logits(\n            logits, targets, reduction='none', pos_weight=self.pos_weight\n        )\n        \n        # Scale the loss dynamically based on how confident the model was\n        focal_loss = (1 - pt) ** self.gamma * bce_loss\n        return focal_loss.mean()\n# ==========================================\n# 4. Multi-Slice Knee Model\n# ==========================================\nclass KneeModel25D(nn.Module):\n    def __init__(self, model_name=CFG.model_name, num_classes=CFG.num_classes, pretrained=True):\n        super().__init__()\n        # 1. CNN Backbone (Now only takes 1 channel per slice instead of 5)\n        self.backbone = timm.create_model(\n            model_name,\n            pretrained=pretrained,\n            num_classes=0,\n            global_pool='avg', \n            in_chans=1,        \n            drop_path_rate=0.2 # Stochastic depth for regularization\n        )\n        \n        in_features = self.backbone.num_features\n        \n        # 2. Sequence Modeler (Reads the 5 slices chronologically)\n        self.gru = nn.GRU(in_features, 256, bidirectional=True, batch_first=True)\n        \n        # 3. Final Classifier\n        self.classifier = nn.Linear(512, num_classes) # 256 * 2 (Bidirectional)\n        \n    def forward(self, x):\n        # x shape comes in as: (Batch, 5_Slices, H, W)\n        B, S, H, W = x.shape\n        \n        # Collapse batch and slices to push through CNN: (Batch * 5, 1, H, W)\n        x = x.view(B * S, 1, H, W)\n        \n        # Extract features from each slice\n        slice_features = self.backbone(x) \n        \n        # Un-collapse back to sequence: (Batch, 5_Slices, Features)\n        sequence = slice_features.view(B, S, -1)\n        \n        # Pass sequence through the BiGRU\n        gru_out, _ = self.gru(sequence) \n        \n        # Max pooling across the 5 slices to find the most severe abnormality\n        pooled_features = torch.max(gru_out, dim=1)[0] \n        \n        logits = self.classifier(pooled_features)\n        return logits","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-08T09:25:47.554728Z","iopub.execute_input":"2026-09-08T09:25:47.555113Z","iopub.status.idle":"2026-09-08T09:25:47.574195Z","shell.execute_reply.started":"2026-09-08T09:25:47.555087Z","shell