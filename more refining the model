ialNumber\", \"\")).strip()\n","                \n","                if institution and institution.upper() not in (\"\", \"ANONYMOUS\", \"UNKNOWN\"):\n","                    scanner_id = f\"INST::{institution}\"\n","                elif serial:\n","                    scanner_id = f\"DEV::{manufacturer}|{model}|{serial}\"\n","                elif manufacturer or model:\n","                    scanner_id = f\"MODEL::{manufacturer}|{model}\"\n","            except Exception:\n","                pass\n","        records.append({\"StudyInstanceUID\": study_uid, \"Scanner_ID\": scanner_id})\n","        \n","    out = pd.DataFrame(records)\n","    assert out[\"StudyInstanceUID\"].is_unique, \"Merge will fan out and corrupt train_df\"\n","    return out\n","\n","# 2. Corrected Regex NLP Parsing\n","condition_to_col = {\n","    \"ACL\": \"ACL\", \"MCL\": \"MCL\",\n","    \"Medial Meniscus\": \"Medial Meniscus\", \"Lateral Meniscus\": \"Lateral Meniscus\",\n","    \"Medial OA\": \"Medial OA\", \"Lateral OA\": \"Lateral OA\", \"PF OA\": \"PF OA\",\n","    \"Effusion\": \"Effusion\", \"Synovitis\": \"Synovitis\", \"Baker's\": \"Baker's\",\n","    \"Contusion\": \"Contusion\", \"Fracture\": \"Fracture\",\n","}\n","\n","keywords = {\n","    \"ACL\": [\"acl\", \"anterior cruciate\"], \"MCL\": [\"mcl\", \"medial collateral\"],\n","    \"Medial Meniscus\": [\"medial meniscus\"], \"Lateral Meniscus\": [\"lateral meniscus\"],\n","    \"Medial OA\": [\"medial compartment\", \"medial osteoarthritis\"], \"Lateral OA\": [\"lateral compartment\", \"lateral osteoarthritis\"],\n","    \"PF OA\": [\"patellofemoral\", \"trochlear\"], \"Effusion\": [\"effusion\", \"fluid\"],\n","    \"Synovitis\": [\"synovitis\"], \"Baker's\": [\"baker\", \"popliteal cyst\"],\n","    \"Contusion\": [\"contusion\", \"bruise\", \"marrow edema\"], \"Fracture\": [\"fracture\", \"fx\"]\n","}\n","negations = [\"no \", \"without \", \"negative for \", \"unremarkable\", \"intact\", \"normal\"]\n","\n","def parse_clinical_report(report):\n","    labels = {col: 0.1 for col in CFG.target_cols}\n","    if not isinstance(report, str):\n","        return pd.Series(labels)\n","        \n","    for sentence in re.split(r'[.\\n]', report.lower()):\n","        is_negated = any(neg in sentence for neg in negations)\n","        for condition, triggers in keywords.items():\n","            if any(t in sentence for t in triggers) and not is_negated:\n","                labels[condition_to_col[condition]] = 0.9\n","                \n","    return pd.Series(labels)\n","\n","# 3. Data Construction (Order of Operations is Critical)\n","train_df = pd.read_csv(CFG.train_csv)\n","train_series_df = pd.read_csv(CFG.train_series_csv)\n","\n","# A. FLAG GOLD STRICTLY FIRST\n","train_df[\"is_gold\"] = train_df[CFG.target_cols].notnull().all(axis=1)\n","\n","# B. GENERATE PSEUDO-LABELS & MERGE\n","pseudo_labels_df = train_df['Report'].apply(parse_clinical_report)\n","train_df.update(pseudo_labels_df, overwrite=False) \n","\n","# C. MERGE SCANNER METADATA\n","scanner_df = extract_scanner_metadata(train_series_df, CFG.train_dicom_dir)\n","train_df = train_df.merge(scanner_df, on=\"StudyInstanceUID\", how=\"left\").fillna({\"Scanner_ID\": \"UNKNOWN\"})\n","\n","train_df.to_csv(\"train_with_robust_labels.csv\", index=False)\n","print(f\"Total Studies: {len(train_df)} | Pure Gold Studies: {train_df['is_gold'].sum()}\")"]},{"cell_type":"code","execution_count":4,"id":"a135417d","metadata":{"execution":{"iopub.execute_input":"2026-09-23T16:29:02.686575Z","iopub.status.busy":"2026-09-23T16:29:02.686319Z","iopub.status.idle":"2026-09-23T16:29:02.697495Z","shell.execute_reply":"2026-09-23T16:29:02.696579Z"},"papermill":{"duration":0.016319,"end_time":"2026-09-23T16:29:02.698983+00:00","exception":false,"start_time":"2026-09-23T16:29:02.682664+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def seed_everything(seed=CFG.seed):\n","    random.seed(seed)\n","    os.environ[\"PYTHONHASHSEED\"] = str(seed